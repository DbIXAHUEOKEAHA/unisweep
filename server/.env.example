# Copy these into Railway → Variables. Never commit real values.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Railway sets this automatically when you attach a Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Your service's public https address, shown to users so they can paste it
# into Unisweep. Railway: Settings -> Networking -> Generate Domain.
PUBLIC_URL=https://your-service.up.railway.app

# Optional tuning (defaults shown).
TZ_NAME=Asia/Singapore
DISPATCH_INTERVAL_S=3
WATCHDOG_INTERVAL_S=60
SILENCE_GRACE_S=240
LOG_LEVEL=INFO
